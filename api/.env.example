DATABASE_URL=postgresql+psycopg://marketstore:marketstore@postgres:5432/marketstore
API_DATABASE_URL=postgresql+psycopg://marketstore:marketstore@127.0.0.1:15432/marketstore
SECRET_KEY=change-this-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_PORT=8000
NGINX_SERVER_NAME=169.58.152.33
NGROK_AUTHTOKEN=replace-with-ngrok-authtoken
NGROK_DOMAIN=https://drinking-relight-trailside.ngrok-free.dev
TRUSTED_HOSTS=localhost,127.0.0.1,api
PASSWORD_RESET_CODE_MINUTES=3
PASSWORD_RESET_COOLDOWN_SECONDS=60
SIGNUP_VERIFICATION_CODE_MINUTES=3
SIGNUP_VERIFICATION_RESEND_SECONDS=180
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=sender-smtp-password
SMTP_FROM_EMAIL=sender@example.com
SMTP_FROM_NAME=MarketStore POS
SMTP_USE_TLS=true
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
API_CELERY_BROKER_URL=redis://127.0.0.1:16379/0
API_CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/1

# Shared secret the release workflow presents to POST /api/v1/app/release-published.
# Set the same value as the repo secret RELEASE_PING_SECRET. Leave empty to disable.
RELEASE_PING_SECRET=
# How often to double-check GitHub for a release the ping missed (seconds).
RELEASE_POLL_SECONDS=600
# Personal access token: raises the GitHub API limit from 60/h to 5000/h.
GITHUB_TOKEN=

# --- Monitoring (Grafana Cloud) --------------------------------------------
# Bo'sh qoldirilsa /metrics endpointi umuman yaratilmaydi va alloy ishlamaydi.
# Token yaratish: openssl rand -hex 32
METRICS_TOKEN=
# Bir nechta server bo'lsa dashboardda qaysi biri ekanini ko'rsatadi.
MONITOR_INSTANCE=marketstore-prod
# Grafana Cloud -> Connections -> "Hosted Prometheus"/"Hosted Logs" sahifasidan.
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
# Ikkalasi uchun bitta Access Policy tokeni (metrics:write, logs:write).
GRAFANA_CLOUD_TOKEN=
